# Build-time settings for Eightfold, read by Vite (only VITE_* names reach the browser code).
# Everything here is PUBLIC and ends up in the built site. Never put a secret in this file:
# secrets (service-role key, database password, Resend or Google client secrets) belong in the
# Supabase or Cloudflare dashboards, or in .env.local, which git ignores. scripts/check-security.mjs
# fails if this file holds anything that looks like a secret.

# Supabase project (Mumbai). The publishable key is public by design; row-level security in the
# database decides what each signed-in person can read or write (D-018).
VITE_SUPABASE_URL=https://txmseoofjrvsmxyaiwps.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_0cSqLO3MihP1lKrelyGlCg_kSiUBW0J
