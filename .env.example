# The build settings Eightfold needs (D-035). This file only lists them: copy it to .env for your
# own builds (git ignores .env), and set the same names as variables in Cloudflare (Workers Builds)
# and GitHub (repository variables) for the hosted builds and CI.
#
# Every value here is public by design: Vite builds VITE_* values into the site's JavaScript.
# Never put a secret in .env either. Secrets (service-role key, database password, Google, Resend,
# the VAPID private key) live only in the Supabase and Cloudflare dashboards.
# scripts/check-security.mjs checks this file, and .env when there is one.

# Supabase → Project Settings → API: the project URL and the publishable key (sb_publishable_...).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Reminders with the app closed (D-028): the VAPID public key from `npm run vapid` (87 characters,
# starting with B). Optional: without it the tracker doesn't offer closed-app reminders.
VITE_VAPID_PUBLIC_KEY=
