# Dependencies (reinstall with `npm install`)
node_modules/

# Build output (rebuild with `npm run build`)
dist/

# Design inspector and browser-test output
.taste-skill/
.playwright-cli/

# Local tool settings (paths on this machine)
.claude/

# Env files never reach git (D-035), not even .env with its public build settings: a tracked .env
# invites a secret into it one day. The build reads the settings from the environment (Cloudflare
# and GitHub variables); .env.example lists their names.
.env
.env.*
!.env.example
# SQL with a secret filled in (scripts/make-vapid-keys.mjs writes supabase/schedule.local.sql)
*.local.sql
# The owner's private docs (D-037): open security weaknesses and personal notes, on their own
# computer only. The public docs are in docs/.
/private/
# Wrangler's local secrets file
.dev.vars
.dev.vars.*

# Wrangler's local runtime state (wrangler dev)
.wrangler/

# Logs and OS clutter
*.log
npm-debug.log*
.DS_Store
Thumbs.db
desktop.ini

# Editors
.vscode/
.idea/

# Supabase CLI local state
supabase/.temp/