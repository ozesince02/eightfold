# Dependencies (reinstall with `npm install`)
node_modules/

# Build output (rebuild with `npm run build`)
dist/

# Design inspector and browser-test output
.taste-skill/
.playwright-cli/

# Local tool settings (paths on this machine)
.claude/

# Env files: .env holds public build settings and is committed (Vite's convention); its contents
# are checked by scripts/check-security.mjs. Every other env file (.env.local, .env.production...)
# may hold secrets and never reaches git.
.env.*
# Wrangler's local secrets file
.dev.vars
.dev.vars.*

# Wrangler's local runtime state (wrangler dev)
.wrangler/

# Logs and OS clutter
*.log
npm-debug.log*
.DS_Store
Thumbs.db
desktop.ini

# Editors
.vscode/
.idea/
